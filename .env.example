# ---------------------------------------------------------------
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ".env" ist per .gitignore ausgeschlossen und darf NICHT ins Git.
# ---------------------------------------------------------------

# Server
PORT=3000
HOST=127.0.0.1
TZ=Europe/Vienna

# Standardland fuer die Sender-Zuordnung: AT oder DE
DEFAULT_COUNTRY=AT

# Was zeigen, wenn der Scraper (scripts/scrape-tv.js) kein Spiel zuordnen konnte?
#   placeholder = "Sender wird noch bekannt gegeben"  (Standard)
#   rule        = grobe Angabe aus config/broadcasters.json, sichtbar als "ca."
BROADCAST_FALLBACK=placeholder

# ---------------------------------------------------------------
# TV-Programm-Scraper (scripts/fetch-tv-guide.js)
# ---------------------------------------------------------------
# Mindestabstand zwischen zwei echten Seitenabrufen, in Sekunden.
# Dazwischen wird der Zwischenspeicher unter data/cache/ verwendet.
# 21600 = 6 Stunden. Mit --force einmalig uebergehen.
SCRAPER_MIN_INTERVAL_SEC=21600

# User-Agent fuer den Abruf. Leer lassen = gaengiger Browser-Kennstring.
SCRAPER_USER_AGENT=

# Datenbank (relativ zum Projektordner)
DATABASE_PATH=data/fussball.db

# ---------------------------------------------------------------
# Datenquelle: "football-data" oder "api-football"
#
# football-data  -> gratis, aber OHNE Oesterreich-Bundesliga,
#                   Europa League und Conference League
# api-football   -> deckt alle 9 Wettbewerbe ab (Gratis-Tarif
#                   mit 100 Anfragen/Tag reicht fuer 1x taeglich)
# ---------------------------------------------------------------
DATA_PROVIDER=football-data

# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# https://dashboard.api-football.com  (oder RapidAPI)
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# ---------------------------------------------------------------
# Automatischer Abgleich
# ---------------------------------------------------------------
# Wie viele Tage im Voraus geladen werden
SYNC_DAYS_AHEAD=14
# Wie viele Tage rueckwirkend (fuer Ergebnisse)
SYNC_DAYS_BACK=2

# ---------------------------------------------------------------
# Zeitplan - laeuft mit dem Server mit (backend/services/scheduler.js).
# Ohne Webserver: "npm run scheduler"
# ---------------------------------------------------------------
SCHEDULE_ENABLED=true

# Taeglich 08:00 und 18:00 Uhr
SCHEDULE_CRON=0 8,18 * * *

# Welche Jobs, in dieser Reihenfolge:
#   sync      football-data -> Tabelle matches   (speist die Web-App!)
#   fixtures  football-data -> Tabelle fixtures
#   tv        FotMob        -> Sender + AT1/EL/UECL
# "tv" gehoert ans Ende, es ordnet die Sender den vorher geholten Spielen zu.
SCHEDULE_JOBS=sync,fixtures,tv

# Zeitlimit je Job in Millisekunden (10 Minuten)
SCHEDULE_TIMEOUT_MS=600000

# Beim Serverstart einmal alles durchlaufen
SYNC_ON_START=false

# Protokolldatei (relativ zum Projektordner)
LOG_FILE=log.txt

# ---------------------------------------------------------------
# Zugangsschutz
#
# Aktiv, sobald BEIDE Werte gesetzt sind. Dann fragt der Browser nach
# Benutzer und Passwort. Ohne sie ist die App offen - der Server schreibt
# beim Start eine Warnung.
#
# Zwingend, sobald HOST nicht mehr 127.0.0.1 ist. Beim Deployment siehe
# DEPLOY.md. Basic Auth ueber unverschluesseltes HTTP uebertraegt das
# Passwort im Klartext - auf Railway/Fly ist HTTPS automatisch dabei.
#
# Ausgenommen bleibt nur /healthz, damit die Plattform den Dienst pruefen
# kann. Der Endpunkt gibt ausschliesslich "ok" zurueck.
# ---------------------------------------------------------------
APP_USER=
APP_PASSWORD=

# Token fuer die Admin-Endpunkte (/api/sync, Sender-Overrides)
ADMIN_TOKEN=bitte-aendern

# ---------------------------------------------------------------
# Kalender-Abo:  https://DEINE-ADRESSE/kalender.ics?token=DIESER-WERT
#
# Leer = Feed abgeschaltet. Der Token ersetzt fuer diesen einen Endpunkt
# das Passwort, weil Google Kalender keine Passwoerter mitschicken kann.
# Wer die URL kennt, sieht den Kalender - also lang und zufaellig waehlen.
# Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Neuer Token = alte Abos funktionieren nicht mehr (so sperrt man jemanden aus).
# ---------------------------------------------------------------
KALENDER_TOKEN=
