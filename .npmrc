# Keine Install-Skripte ausfuehren.
#
# WARUM:
# better-sqlite3 liefert ab Version 13 fertige Binaries fuer alle gaengigen
# Plattformen im Paket mit (node_modules/better-sqlite3/prebuilds/, u. a.
# linux-x64 und linuxmusl-x64 fuer den Server). Es muss also nichts
# kompiliert werden.
#
# Trotzdem versucht npm es: Liegt eine binding.gyp im Paket und ist kein
# eigenes install-Skript definiert, ruft npm von sich aus "node-gyp rebuild"
# auf. Das braucht Python und C++-Buildtools - die es in den schlanken
# Docker-Images der Hosting-Plattformen nicht gibt. Der Build bricht dann ab
# mit "gyp ERR! find Python".
#
# Mit dieser Einstellung installiert "npm ci" in Sekunden und nutzt die
# beiliegende Binary.
#
# ACHTUNG beim Hinzufuegen neuer Abhaengigkeiten:
# Braucht ein Paket wirklich einen Build-Schritt, wird er jetzt still
# uebersprungen. In dem Fall entweder hier eine Ausnahme ergaenzen oder
# einmalig "npm install --foreground-scripts" laufen lassen.
ignore-scripts=true
