# systemd-Dienst fuer den Dauerbetrieb auf einem Linux-Server.
#
# Sorgt dafuer, dass die App beim Booten startet und nach einem Absturz
# automatisch wieder hochkommt. Damit laeuft auch der Zeitplan durch.
#
# Installieren:
#   sudo cp deploy/fussball-programm.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fussball-programm
#
# Status und Logs:
#   sudo systemctl status fussball-programm
#   sudo journalctl -u fussball-programm -f

[Unit]
Description=Fussball-TV-Programm
Documentation=https://github.com/DEIN-NAME/fussball-programm
# Erst starten, wenn das Netz wirklich da ist - sonst scheitert der
# erste Abgleich beim Booten.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fussball-programm

# Die Umgebungsvariablen kommen aus der .env, die liest die App selbst
# ueber dotenv ein. Die Zeitzone muss aber schon beim Start von Node
# stehen - sonst rechnet Node in UTC und der Zeitplan feuert zwei
# Stunden zu spaet.
Environment=NODE_ENV=production
Environment=TZ=Europe/Vienna

ExecStart=/usr/bin/node backend/server.js

# Immer neu starten, auch nach sauberem Beenden. 10 Sekunden Pause,
# damit ein Startfehler nicht zur Endlosschleife wird.
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fussball

# --- Absicherung ---------------------------------------------------
# Die App braucht nichts davon, also wegnehmen.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ProtectHome bleibt aus: das Projekt liegt unter /home/ubuntu.
ProtectHome=false

[Install]
WantedBy=multi-user.target
